{
  "manifest_version": 3,
  "name": "VozClara — áudios do WhatsApp em texto",
  "short_name": "VozClara",
  "version": "1.9.3",
  "description": "Transcreva áudios do WhatsApp Web. Whisper no Chrome com um clique, ou nuvem (OpenAI, Gemini, Groq, xAI).",
  "minimum_chrome_version": "116",
  "permissions": ["contextMenus", "storage", "offscreen", "downloads"],
  "host_permissions": [
    "https://web.whatsapp.com/*",
    "https://api.openai.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://api.groq.com/*",
    "https://api.x.ai/*",
    "https://huggingface.co/*",
    "https://*.huggingface.co/*",
    "https://hf.co/*",
    "https://*.hf.co/*",
    "https://*.xethub.hf.co/*",
    "https://cdn.jsdelivr.net/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "VozClara",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["inject.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["shared.js", "content.js", "dock.js"],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  }
}
